; Inno Setup 6 script for the SparkMusic Windows package.
;
; Generated by packaging/windows/package.ps1, which passes:
;   /DMyAppVersion=0.1.3
;   /DMyAppDisplayVersion=0.1.3-beta
;   /DStageDir=<absolute stage folder>
;   /DOutputDir=<absolute dist folder>
;   /DMyAppIcon=<absolute gui/sparkmusic.ico>
;
; The stage folder already contains sparkmusic.exe, sparkmusic_core.dll, the
; Qt 6 DLLs/plugins minus translations, the MSVC runtime and the license texts;
; this script only wraps it in a standard per-machine installer.

#ifndef MyAppVersion
  #define MyAppVersion "0.1.3"
#endif
#ifndef MyAppDisplayVersion
  #define MyAppDisplayVersion "0.1.3-beta"
#endif
#ifndef StageDir
  #define StageDir "..\..\build-windows\sparkmusic-0.1.3-beta-windows-x64"
#endif
#ifndef OutputDir
  #define OutputDir "..\..\dist"
#endif
#ifndef MyAppIcon
  #define MyAppIcon "..\..\gui\sparkmusic.ico"
#endif

[Setup]
AppId={{D577CC16-C3ED-5E6F-9E4B-E2C958059073}
AppName=SparkMusic
AppVersion={#MyAppVersion}
AppVerName=SparkMusic {#MyAppDisplayVersion}
AppPublisher=FORGE24
AppPublisherURL=https://github.com/FORGE24/SparkMusic
AppSupportURL=https://github.com/FORGE24/SparkMusic/issues
AppUpdatesURL=https://github.com/FORGE24/SparkMusic/releases
AppCopyright=Copyright (C) FORGE24. Apache-2.0; Qt LGPL-3.0.
DefaultDirName={autopf}\SparkMusic
DefaultGroupName=SparkMusic
DisableProgramGroupPage=yes
LicenseFile={#StageDir}\LICENSE
OutputDir={#OutputDir}
OutputBaseFilename=sparkmusic-{#MyAppDisplayVersion}-windows-x64-setup
SetupIconFile={#MyAppIcon}
UninstallDisplayIcon={app}\sparkmusic.exe
Compression=lzma2/max
SolidCompression=yes
WizardStyle=modern
ArchitecturesAllowed=x64
ArchitecturesInstallIn64BitMode=x64
PrivilegesRequired=admin
CloseApplications=yes
RestartApplications=no
VersionInfoVersion={#MyAppVersion}.0
VersionInfoProductName=SparkMusic
VersionInfoProductVersion={#MyAppVersion}.0
VersionInfoCompany=FORGE24
VersionInfoDescription=SparkMusic {#MyAppDisplayVersion} installer

[Tasks]
Name: "desktopicon"; Description: "Create a desktop shortcut"; GroupDescription: "Additional shortcuts:"

[Files]
Source: "{#StageDir}\*"; DestDir: "{app}"; Flags: ignoreversion recursesubdirs createallsubdirs

[Icons]
Name: "{autoprograms}\SparkMusic"; Filename: "{app}\sparkmusic.exe"
Name: "{autodesktop}\SparkMusic"; Filename: "{app}\sparkmusic.exe"; Tasks: desktopicon

[Run]
Filename: "{app}\sparkmusic.exe"; Description: "Launch SparkMusic"; Flags: nowait postinstall skipifsilent
